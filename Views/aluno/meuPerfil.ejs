<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Meu Perfil</title>
    <link rel="stylesheet" href="../../Css/Aluno/perfil.css">
</head>
<body>

<aside class="barraLateral">

    <div class="logo"><span>IF</span><span>Sports</span></div>

    <div class="perfil-container">
        <div class="foto-perfil-box">
            <img src="../../img/Pedrão.jpeg" alt="Foto de Perfil" class="foto-perfil">
        </div>

        <a href="/meuPerfil" class="btn-perfil">
            <span class="icon-mask icon-perfil"></span>
            <span>Meu Perfil</span>
        </a>
    </div>

    <section id="Saudacoes">
        <p id="OlaAluno">Olá, Pedro! 👋</p>
    </section>

</aside>

<main class="TelaPerfil">

    <header id="Header">

        <h1 id="TituloPagina">Meu Perfil</h1>

        <div class="header-actions">
            <button class="icon-btn" aria-label="Notificações">
                <span class="icon-mask icon-sino"></span>
            </button>

            <button class="icon-btn" aria-label="Sair">
                <span class="icon-mask icon-sair"></span>
            </button>
        </div>

    </header>

    <nav id="UpperNav">

        <a href="/Dashbord" class="nav-btn">
            <span class="icon-mask icon-home"></span>
            <span class="Texto">Home</span>
        </a>

        <a href="/Modalidades" class="nav-btn">
            <span class="icon-mask icon-modalidades"></span>
            <span class="Texto">Modalidades</span>
        </a>

        <a href="/MeuDesempenho" class="nav-btn">
            <span class="icon-mask icon-desempenho"></span>
            <span class="Texto">Meu Desempenho</span>
        </a>

    </nav>

    <section class="conteudo">

        <article class="card card-identificacao">

            <div class="perfil-principal">

                <div class="foto-grande">
                    <img src="../../img/Pedrão.jpeg" alt="Foto de Pedro Felipe de Andrade Silva Almeida">
                </div>

                <div class="dados-principais">
                    <span class="card-label">Aluno</span>
                    <h2>Pedro Felipe de Andrade Silva Almeida</h2>
                    <p>Licenciatura em Ciências da Computação</p>
                    <span class="status">Aluno ativo</span>
                </div>

            </div>

            <div class="dados-academicos">

                <div class="info-item">
                    <span>Matrícula</span>
                    <strong>20231SBF06GL0032</strong>
                </div>

                <div class="info-item">
                    <span>Turma</span>
                    <strong>2023.1</strong>
                </div>
                
                <div class="info-item">
                    <span>Telefone</span>
                    <strong>(74) 98141-0228</strong>
                </div>

                <div class="info-item">
                    <span>E-mail</span>
                    <strong>PFASA@gmail.com</strong>
                </div>

            </div>

        </article>

        <div class="perfil-grid">

            <article class="card card-fisico">

                <div class="card-header">
                    <div>
                        <span class="card-label">Informações físicas</span>
                        <h2>Dados corporais</h2>
                    </div>

                    <span class="icon-mask icon-fisico"></span>
                </div>

                <div class="dados-fisicos">

                    <div class="dado-fisico">
                        <span>Altura</span>
                        <strong>1,78 m</strong>
                    </div>

                    <div class="dado-fisico">
                        <span>Peso</span>
                        <strong>88 kg</strong>
                    </div>

                    <div class="dado-fisico">
                        <span>Sexo</span>
                        <strong>Masculino</strong>
                    </div>

                    <div class="dado-fisico">
                        <span>Data de nascimento</span>
                        <strong>22/02/2005</strong>
                    </div>

                </div>

                <div class="imc-box">

                    <div class="imc-info">
                        <span>IMC</span>
                        <strong>27,8</strong>
                    </div>

                    <div class="imc-classificacao">
                        <span>Sobrepeso</span>
                        <div class="imc-barra">
                            <span></span>
                        </div>
                    </div>

                </div>

            </article>

            <article class="card card-modalidades">

                <div class="card-header">
                    <div>
                        <span class="card-label">Participação esportiva</span>
                        <h2>Modalidades ativas</h2>
                    </div>

                    <span class="icon-mask icon-modalidades"></span>
                </div>

                <div class="modalidades-ativas">

                    <div class="modalidade">
                        <div class="modalidade-icone basquete">🏀</div>
                        <div>
                            <strong>Basquete</strong>
                            <span>Participando</span>
                        </div>
                    </div>

                    <div class="modalidade">
                        <div class="modalidade-icone natacao">🏊</div>
                        <div>
                            <strong>Natação</strong>
                            <span>Participando</span>
                        </div>
                    </div>

                </div>

            </article>

        </div>

        <article class="card card-nascimento">

            <div class="nascimento-info">
                <span class="card-label">Dados pessoais</span>
                <h2>Informações do aluno</h2>
                <p>Confira seus dados cadastrais e informações físicas.</p>
            </div>

            <div class="resumo-dados">
                <div>
                    <span>Nome</span>
                    <strong>Pedro Felipe</strong>
                </div>

                <div>
                    <span>Sexo</span>
                    <strong>Masculino</strong>
                </div>

                <div>
                    <span>Nascimento</span>
                    <strong>22/02/2005</strong>
                </div>
            </div>

        </article>

    </section>

</main>

</body>
</html>